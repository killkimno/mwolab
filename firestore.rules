rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInWithGoogle() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function fittingPath(fittingId) {
      return /databases/$(database)/documents/publicFittings/$(fittingId);
    }

    function ownerPath(fittingId) {
      return /databases/$(database)/documents/fittingOwners/$(fittingId);
    }

    function likePath(fittingId, uid) {
      return /databases/$(database)/documents/publicFittings/$(fittingId)/likes/$(uid);
    }

    function usagePath(uid) {
      return /databases/$(database)/documents/publisherUsage/$(uid);
    }

    function validUsageAdvance(fittingId) {
      return getAfter(usagePath(request.auth.uid)).data.lastFittingId == fittingId
        && getAfter(usagePath(request.auth.uid)).data.publishCount <= 5
        && (
          (
            !exists(usagePath(request.auth.uid))
            && getAfter(usagePath(request.auth.uid)).data.publishCount == 1
          )
          || (
            exists(usagePath(request.auth.uid))
            && getAfter(usagePath(request.auth.uid)).data.publishCount
              == get(usagePath(request.auth.uid)).data.publishCount + 1
          )
        );
    }

    function validNewFitting(fittingId) {
      return request.resource.data.keys().hasOnly([
          'loadoutCode', 'likeCount', 'createdAt', 'schemaVersion'
        ])
        && request.resource.data.loadoutCode is string
        && request.resource.data.loadoutCode.size() >= 36
        && request.resource.data.loadoutCode.size() <= 4096
        && request.resource.data.loadoutCode.matches(
          '^A[0-o|]+p[0-o|]+q[0-o|]+r[0-o|]+s[0-o|]+t[0-o|]+u[0-o|]+v[0-o|]+w[0-o]+$'
        )
        && request.resource.data.likeCount == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.schemaVersion == 1
        && getAfter(ownerPath(fittingId)).data.uid == request.auth.uid
        && validUsageAdvance(fittingId);
    }

    function validLikeCountChange(fittingId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
        && resource.data.likeCount is int
        && request.resource.data.likeCount is int
        && request.resource.data.likeCount >= 0
        && (
          (
            request.resource.data.likeCount == resource.data.likeCount + 1
            && !exists(likePath(fittingId, request.auth.uid))
            && existsAfter(likePath(fittingId, request.auth.uid))
          )
          || (
            request.resource.data.likeCount == resource.data.likeCount - 1
            && exists(likePath(fittingId, request.auth.uid))
            && !existsAfter(likePath(fittingId, request.auth.uid))
          )
        );
    }

    match /publicFittings/{fittingId} {
      allow get: if true;
      allow list: if request.query.limit != null && request.query.limit <= 20;
      allow create: if signedInWithGoogle() && validNewFitting(fittingId);
      allow update: if signedInWithGoogle() && validLikeCountChange(fittingId);
      allow delete: if false;

      match /likes/{uid} {
        allow get: if signedInWithGoogle() && uid == request.auth.uid;
        allow list: if false;
        allow create: if signedInWithGoogle()
          && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time
          && !exists(likePath(fittingId, uid))
          && getAfter(fittingPath(fittingId)).data.likeCount
            == get(fittingPath(fittingId)).data.likeCount + 1;
        allow update: if false;
        allow delete: if signedInWithGoogle()
          && uid == request.auth.uid
          && getAfter(fittingPath(fittingId)).data.likeCount
            == get(fittingPath(fittingId)).data.likeCount - 1;
      }
    }

    match /fittingOwners/{fittingId} {
      allow get: if signedInWithGoogle() && resource.data.uid == request.auth.uid;
      allow list: if false;
      allow create: if signedInWithGoogle()
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && getAfter(fittingPath(fittingId)).data.schemaVersion == 1;
      allow update, delete: if false;
    }

    match /publisherUsage/{uid} {
      allow get: if signedInWithGoogle() && uid == request.auth.uid;
      allow list: if false;
      allow create: if signedInWithGoogle()
        && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['publishCount', 'lastFittingId', 'updatedAt'])
        && request.resource.data.publishCount == 1
        && request.resource.data.lastFittingId is string
        && request.resource.data.updatedAt == request.time
        && getAfter(fittingPath(request.resource.data.lastFittingId)).data.schemaVersion == 1
        && getAfter(ownerPath(request.resource.data.lastFittingId)).data.uid == uid;
      allow update: if signedInWithGoogle()
        && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['publishCount', 'lastFittingId', 'updatedAt'])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['publishCount', 'lastFittingId', 'updatedAt'])
        && resource.data.publishCount is int
        && request.resource.data.publishCount == resource.data.publishCount + 1
        && request.resource.data.publishCount <= 5
        && request.resource.data.lastFittingId is string
        && request.resource.data.updatedAt == request.time
        && getAfter(fittingPath(request.resource.data.lastFittingId)).data.schemaVersion == 1
        && getAfter(ownerPath(request.resource.data.lastFittingId)).data.uid == uid;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
